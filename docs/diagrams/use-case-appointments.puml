@startuml use-case-appointments
title Use-Case Diagram 1 – Appointments
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F4FAF9
  BorderColor #0E6E68
}
skinparam actorBorderColor #0E6E68

actor Patient
actor Receptionist
actor Doctor

rectangle "Healthcare Appointment & Patient Record System" {
  usecase "Register / log in" as UC1
  usecase "Search doctors & free slots" as UC2
  usecase "Book appointment" as UC3
  usecase "Check for conflicts" as UC3a
  usecase "Reschedule appointment" as UC4
  usecase "Cancel appointment" as UC5
  usecase "Receive notifications\nand reminders" as UC6
  usecase "Register walk-in patient" as UC7
  usecase "Book on behalf of patient" as UC8
  usecase "Check patient in" as UC9
  usecase "Set weekly availability" as UC10
  usecase "Mark leave" as UC11
  usecase "View daily schedule" as UC12
}

Patient --> UC1
Patient --> UC2
Patient --> UC3
Patient --> UC4
Patient --> UC5
Patient --> UC6
UC3 .> UC3a : <<include>>
UC4 .> UC3a : <<include>>
UC8 .> UC3a : <<include>>
UC3 <.. UC8 : <<extend>>
Receptionist --> UC7
Receptionist --> UC8
Receptionist --> UC9
Receptionist --> UC5
Doctor --> UC10
Doctor --> UC11
Doctor --> UC12
@enduml
